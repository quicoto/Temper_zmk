#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800  // 600, 1200
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mmv_input_listener {
    precisionnav {
        layers = <1>;
        input-processors = <&zip_xy_scaler 1 3>;
    };

    precisionnum {
        layers = <2>;
        input-processors = <&zip_xy_scaler 1 2>;
    };
};

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

&lt { tapping-term-ms = <165>; };

/ {
    behaviors {
        mmv {
            acceleration-exponent = <2>; // 1
            time-to-max-speed-ms = <40>; // 40
            delay-ms = <0>; // 0
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <65>;
            tapping-term-ms = <125>;
            global-quick-tap;
            flavor = "tap-preferred";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <105>;
            quick-tap-ms = <60>;
            flavor = "hold-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 20 21 22 23 24 14 25 15 5 6 16 26 27 17 7 8 18 28 29 19 9 11 12 13>;
            require-prior-idle-ms = <70>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <105>;
            quick-tap-ms = <60>;
            flavor = "hold-preferred";
            hold-trigger-key-positions = <0 10 20 21 1 11 12 2 3 4 24 14 13 23 22 25 26 28 27 29 9 8 7 6 5 15 16 17 18 30 31 32 33 34 35>;
            require-prior-idle-ms = <70>;
            hold-trigger-on-release;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        space_alt: space_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_ALT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            quick-tap-ms = <100>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <10 12 20 21 16 17 19 6>;
            hold-trigger-on-release;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
  &kp Q             &kp W  &kp E             &kp R             &kp T                   &kp Y      &kp U        &kp I            &kp O    &kp P
  &kp A             &kp S  &kp D             &kp F             &kp G                   &kp H      &kp J        &kp K            &kp L    &hmr RIGHT_SHIFT SINGLE_QUOTE
  &mt LEFT_SHIFT Z  &kp X  &kp C             &kp V             &kp B                   &kp N      &kp M        &kp COMMA        &kp DOT  &mt RIGHT_SHIFT SLASH
                           &mt LEFT_ALT ESC  &kp LEFT_COMMAND  &mt LEFT_CONTROL TAB    &kp ENTER  &lt 1 SPACE  &lt 2 BACKSPACE
            >;
        };

        Symbol {
            bindings = <
  &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp N5           &kp NUMBER_6    &kp N7          &kp N8            &kp N9             &kp N0
  &kp TILDE       &kp HOME      &kp PAGE_UP   &kp PAGE_DOWN  &sk END          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW      &kp RIGHT_ARROW    &kp SEMI
  &kp LEFT_SHIFT  &trans        &trans        &trans         &kp LG(MINUS)    &kp LG(PLUS)    &kp EQUAL       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mt RIGHT_SHIFT LG(PIPE)
                                &trans        &trans         &trans           &trans          &trans          &trans
            >;
        };

        Function {
            bindings = <
  &kp F1   &kp F2   &kp F3          &kp F4            &kp F5        &kp F6      &kp F7        &kp F8           &kp F9                &kp F10
  &kp F11  &kp F12  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &kp C_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC
  &trans   &trans   &trans          &trans            &trans        &trans      &trans        &trans           &trans                &trans
                    &trans          &trans            &trans        &trans      &trans        &trans
            >;
        };
    };
};
